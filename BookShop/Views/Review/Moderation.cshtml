@model BookShop.Models.ViewModels.AdminReviewModerationVM
@inject BookShop.Services.ILanguageService Lang

@{
    var isRtl = Lang.IsRtl;
    ViewData["Title"] = Lang["Review_ModTitle"];
}

<div class="container py-4">

    <!-- Header & Breadcrumb -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small text-muted mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">@Lang["Nav_Home"]</a></li>
                    <li class="breadcrumb-item active text-dark" aria-current="page">@Lang["Review_ModTitle"]</li>
                </ol>
            </nav>
            <h1 class="h3 font-serif fw-bold text-dark mb-1 d-flex align-items-center">
                <i class="bi bi-star-half @(isRtl ? "ms-2" : "me-2")" style="color: var(--c-cafe);"></i>
                @Lang["Review_ModTitle"]
            </h1>
            <p class="text-muted small mb-0">@Lang["Review_ModSubtitle"]</p>
        </div>

        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Book" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 btn-sm d-flex align-items-center shadow-sm">
                <i class="bi bi-book @(isRtl ? "ms-2" : "me-2")"></i>
                @Lang["Nav_BooksCatalog"]
            </a>
        </div>
    </div>

    <!-- Filter Tabs & Search Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <!-- Tabs -->
        <div class="btn-group shadow-sm rounded-pill overflow-hidden border bg-white p-1" role="group">
            <a asp-action="Moderation" asp-route-search="@Model.SearchQuery"
               class="btn btn-sm rounded-pill px-3 py-1 @(!Model.FilterApproved.HasValue ? "btn-primary shadow-none" : "btn-light text-muted border-0")">
                @Lang["Review_TabAll"] (@Model.TotalCount)
            </a>
            <a asp-action="Moderation" asp-route-approved="true" asp-route-search="@Model.SearchQuery"
               class="btn btn-sm rounded-pill px-3 py-1 @(Model.FilterApproved == true ? "btn-success text-white shadow-none" : "btn-light text-muted border-0")">
                <i class="bi bi-check-circle @(isRtl ? "ms-1" : "me-1")"></i>
                @Lang["Review_TabApproved"] (@Model.ApprovedCount)
            </a>
            <a asp-action="Moderation" asp-route-approved="false" asp-route-search="@Model.SearchQuery"
               class="btn btn-sm rounded-pill px-3 py-1 @(Model.FilterApproved == false ? "btn-warning text-dark shadow-none" : "btn-light text-muted border-0")">
                <i class="bi bi-eye-slash @(isRtl ? "ms-1" : "me-1")"></i>
                @Lang["Review_TabHidden"] (@Model.HiddenCount)
            </a>
        </div>

        <!-- Search Bar -->
        <form method="get" asp-action="Moderation" class="d-flex gap-2">
            <input type="hidden" name="approved" value="@Model.FilterApproved" />
            <div class="input-group input-group-sm">
                <input type="search" name="search" value="@Model.SearchQuery" class="form-control rounded-start-pill ps-3"
                       placeholder="Search book, reader, or keyword..." style="min-width: 240px;" />
                <button type="submit" class="btn btn-outline-secondary rounded-end-pill px-3">
                    <i class="bi bi-search"></i>
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || Model.FilterApproved.HasValue)
            {
                <a asp-action="Moderation" class="btn btn-sm btn-link text-muted align-self-center">
                    @Lang["Inventory_ResetFilter"]
                </a>
            }
        </form>
    </div>

    <!-- Moderation Table -->
    @if (!Model.Reviews.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3 my-4" style="background-color: var(--c-parchment);">
            <div class="card-body py-5">
                <i class="bi bi-chat-square-quote fs-1 text-muted mb-3 d-block"></i>
                <h3 class="font-serif fw-bold text-dark mb-2">No reviews found</h3>
                <p class="text-muted mx-auto mb-4" style="max-width: 480px;">
                    No reader reflections match the current filter or search criteria.
                </p>
                <a asp-action="Moderation" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">
                    @Lang["Inventory_ResetFilter"]
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive bg-white rounded-4 shadow-sm border overflow-hidden">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-muted">
                    <tr>
                        <th class="ps-4">Book</th>
                        <th>Reviewer</th>
                        <th class="text-center">Rating</th>
                        <th>Review Details</th>
                        <th class="text-center">Status</th>
                        <th class="pe-4 text-end">Moderation</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var review in Model.Reviews)
                    {
                        var cover = !string.IsNullOrWhiteSpace(review.CoverImageUrl) ? review.CoverImageUrl : "/images/default-book-cover.svg";
                        <tr class="@(!review.IsApproved ? "table-warning bg-opacity-25" : "")">
                            <!-- Book Edition -->
                            <td class="ps-4 py-3" style="min-width: 200px;">
                                <div class="d-flex align-items-center">
                                    <img src="@cover" alt="@review.GetDisplayTitle(isRtl)"
                                         class="rounded shadow-xs @(isRtl ? "ms-3" : "me-3")" style="width: 38px; height: 52px; object-fit: cover;" />
                                    <div>
                                        <a href="/Home/Details/@review.BookId" target="_blank" class="fw-bold text-dark font-serif text-decoration-none" style="font-size: 0.9rem;">
                                            @review.GetDisplayTitle(isRtl)
                                        </a>
                                        <div class="small text-muted font-monospace">ID: #@review.BookId</div>
                                    </div>
                                </div>
                            </td>

                            <!-- Reviewer -->
                            <td style="min-width: 160px;">
                                <div class="fw-semibold small text-dark">@review.ReviewerName</div>
                                <div class="text-muted small font-monospace" style="font-size: 0.75rem;">@review.ReviewerEmail</div>
                                @if (review.IsVerifiedPurchase)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill py-0 px-2 mt-1" style="font-size: 0.68rem;">
                                        <i class="bi bi-patch-check-fill @(isRtl ? "ms-1" : "me-1")"></i>@Lang["Review_VerifiedPurchase"]
                                    </span>
                                }
                            </td>

                            <!-- Star Rating -->
                            <td class="text-center text-nowrap" style="min-width: 100px;">
                                <div class="text-warning small mb-1">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        if (s <= review.Rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-muted opacity-25"></i>
                                        }
                                    }
                                </div>
                                <span class="badge bg-light text-dark border rounded-pill px-2 py-0 small">
                                    @review.Rating / 5
                                </span>
                            </td>

                            <!-- Content -->
                            <td style="max-width: 360px;">
                                @if (!string.IsNullOrWhiteSpace(review.Headline))
                                {
                                    <div class="fw-bold text-dark small mb-1 font-serif">@review.Headline</div>
                                }
                                <div class="small text-secondary text-truncate" title="@review.Comment" style="max-width: 320px;">
                                    @review.Comment
                                </div>
                                <div class="text-muted small mt-1 font-monospace" style="font-size: 0.72rem;">
                                    @review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                </div>
                            </td>

                            <!-- Visibility Status -->
                            <td class="text-center text-nowrap">
                                @if (review.IsApproved)
                                {
                                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-1">
                                        <i class="bi bi-check-circle-fill @(isRtl ? "ms-1" : "me-1")"></i>@Lang["Review_StatusApproved"]
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-warning-subtle text-dark border border-warning-subtle px-3 py-1">
                                        <i class="bi bi-eye-slash-fill @(isRtl ? "ms-1" : "me-1")"></i>@Lang["Review_StatusHidden"]
                                    </span>
                                }
                            </td>

                            <!-- Actions -->
                            <td class="pe-4 text-end text-nowrap">
                                <form method="post" asp-action="ToggleApproval" asp-route-id="@review.Id" class="d-inline">
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    @if (review.IsApproved)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-2 py-1 shadow-xs" title="@Lang["Review_ActionHide"]">
                                            <i class="bi bi-eye-slash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-2 py-1 shadow-xs" title="@Lang["Review_ActionApprove"]">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    }
                                </form>

                                <form method="post" asp-action="AdminDelete" asp-route-id="@review.Id" class="d-inline ms-1"
                                      onsubmit="return confirm('@Lang["Review_ConfirmDelete"]');">
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1 shadow-xs" title="@Lang["Review_DeleteBtn"]">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>
