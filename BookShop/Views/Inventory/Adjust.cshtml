@model BookShop.Models.ViewModels.StockAdjustmentVM
@using BookShop.Models.Enums
@inject BookShop.Services.ILanguageService Lang

@{
    var isRtl = Lang.IsRtl;
    ViewData["Title"] = Lang["Inventory_AdjustTitle"];
    var displayCover = !string.IsNullOrWhiteSpace(Model.CoverImageUrl) ? Model.CoverImageUrl : "/images/default-book-cover.svg";
}

<div class="container py-4" style="max-width: 780px;">

    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small text-muted mb-1">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">@Lang["Nav_Home"]</a></li>
            <li class="breadcrumb-item"><a asp-controller="Inventory" asp-action="Index" class="text-decoration-none text-muted">@Lang["Inventory_DashboardTitle"]</a></li>
            <li class="breadcrumb-item active text-dark" aria-current="page">@Lang["Inventory_AdjustTitle"]</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <!-- Card Header Banner -->
        <div class="p-4 border-bottom text-white" style="background-color: var(--c-espresso);">
            <div class="d-flex align-items-center">
                <div class="rounded-circle p-3 d-flex align-items-center justify-content-center bg-white bg-opacity-10 @(isRtl ? "ms-3" : "me-3")" style="width: 52px; height: 52px;">
                    <i class="bi bi-pencil-square fs-4 text-white"></i>
                </div>
                <div>
                    <h2 class="h4 font-serif fw-bold text-white mb-1">@Lang["Inventory_AdjustTitle"]</h2>
                    <p class="small text-white-50 mb-0">@Lang["Inventory_AdjustSubtitle"]</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <!-- Book Identity Card -->
            <div class="d-flex align-items-center p-3 rounded-3 mb-4 border" style="background-color: var(--c-parchment);">
                <img src="@displayCover" alt="@Model.GetDisplayTitle(isRtl)"
                     class="rounded shadow-xs @(isRtl ? "ms-3" : "me-3")" style="width: 56px; height: 78px; object-fit: cover;" />
                <div class="flex-grow-1">
                    <span class="badge bg-secondary-subtle text-secondary small mb-1">ID: #@Model.BookId</span>
                    <h3 class="h5 font-serif fw-bold text-dark mb-1">@Model.GetDisplayTitle(isRtl)</h3>
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted">@Lang["Inventory_CurrentStock"]:</span>
                        <span class="badge @(Model.CurrentStock <= 0 ? "bg-danger" : (Model.CurrentStock <= 5 ? "bg-warning text-dark" : "bg-success")) rounded-pill px-3 py-1 fw-bold fs-6">
                            @Model.CurrentStock @Lang["Inventory_AdjustUnits"]
                        </span>
                    </div>
                </div>
            </div>

            <!-- Adjustment Form -->
            <form method="post" asp-action="Adjust">
                <input type="hidden" asp-for="BookId" />
                <input type="hidden" asp-for="CurrentStock" />
                <input type="hidden" asp-for="BookTitle" />
                <input type="hidden" asp-for="BookTitleAr" />
                <input type="hidden" asp-for="CoverImageUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2 mb-3" role="alert"></div>

                <!-- Quantity Change Input -->
                <div class="mb-4">
                    <label asp-for="QuantityChange" class="form-label fw-bold text-dark">
                        @Lang["Inventory_QuantityChange"] <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted">
                            <i class="bi bi-plus-slash-minus"></i>
                        </span>
                        <input asp-for="QuantityChange" type="number" class="form-control form-control-lg font-monospace"
                               placeholder="e.g. 15 or -3" id="quantityChangeInput" required />
                    </div>
                    <span asp-validation-for="QuantityChange" class="text-danger small d-block mt-1"></span>
                    <div class="form-text small text-muted mt-1">
                        @Lang["Inventory_QuantityHelp"]
                    </div>
                    
                    <!-- Projected Result Banner -->
                    <div class="mt-2 p-2 rounded-3 bg-light border small text-dark d-none" id="projectedStockBanner">
                        <i class="bi bi-calculator @(isRtl ? "ms-1" : "me-1")"></i>
                        <span id="projectedStockText"></span>
                    </div>
                </div>

                <!-- Transaction Type Select -->
                <div class="mb-4">
                    <label asp-for="TransactionType" class="form-label fw-bold text-dark">
                        @Lang["Inventory_TransactionType"] <span class="text-danger">*</span>
                    </label>
                    <select asp-for="TransactionType" class="form-select" id="transactionTypeSelect" required>
                        <option value="@InventoryTransactionType.Purchase">@Lang["Inventory_TypePurchase"] (+)</option>
                        <option value="@InventoryTransactionType.Adjustment">@Lang["Inventory_TypeAdjustment"] (+ / -)</option>
                        <option value="@InventoryTransactionType.Return">@Lang["Inventory_TypeReturn"] (+)</option>
                        <option value="@InventoryTransactionType.Damage">@Lang["Inventory_TypeDamage"] (-)</option>
                        <option value="@InventoryTransactionType.Sale">@Lang["Inventory_TypeSale"] (-)</option>
                    </select>
                    <span asp-validation-for="TransactionType" class="text-danger small"></span>
                </div>

                <!-- Reason / Audit Reference Note -->
                <div class="mb-4">
                    <label asp-for="Reason" class="form-label fw-bold text-dark">
                        @Lang["Inventory_ReasonLabel"] <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="Reason" class="form-control" rows="3"
                              placeholder="@Lang["Inventory_ReasonPlaceholder"]" required></textarea>
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                </div>

                <!-- Educational Audit Notice -->
                <div class="alert alert-info border-0 rounded-3 small mb-4 d-flex align-items-start" style="background-color: rgba(94, 114, 228, 0.08);">
                    <i class="bi bi-shield-check fs-5 text-primary @(isRtl ? "ms-2" : "me-2") mt-1"></i>
                    <div>
                        <strong class="d-block text-primary">Immutable Audit Guarantee (سجل غير قابل للتعديل)</strong>
                        <span class="text-muted">
                            Every stock modification is written into the append-only ledger with your user credentials, timestamp, quantity delta, and snapshot of before/after stock balances.
                        </span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                        <i class="bi bi-arrow-left @(isRtl ? "bi-arrow-right" : "") @(isRtl ? "ms-1" : "me-1")"></i>
                        @Lang["Inventory_CancelAdjustment"]
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">
                        <i class="bi bi-check-lg @(isRtl ? "ms-1" : "me-1")"></i>
                        @Lang["Inventory_ConfirmAdjustment"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const currentStock = @Model.CurrentStock;
            const input = document.getElementById('quantityChangeInput');
            const banner = document.getElementById('projectedStockBanner');
            const text = document.getElementById('projectedStockText');

            function updateProjected() {
                const delta = parseInt(input.value);
                if (isNaN(delta) || delta === 0) {
                    banner.classList.add('d-none');
                    return;
                }
                const projected = currentStock + delta;
                banner.classList.remove('d-none');
                if (projected < 0) {
                    banner.className = 'mt-2 p-2 rounded-3 bg-danger bg-opacity-10 border border-danger small text-danger';
                    text.innerHTML = '<strong>Warning:</strong> Resulting stock would be negative (' + projected + '). Stock cannot be less than zero.';
                } else {
                    banner.className = 'mt-2 p-2 rounded-3 bg-light border small text-dark';
                    text.innerHTML = 'Current (' + currentStock + ') ' + (delta > 0 ? '+ ' + delta : '- ' + Math.abs(delta)) + ' = <strong>' + projected + ' units</strong> after adjustment.';
                }
            }

            input.addEventListener('input', updateProjected);
            updateProjected();
        });
    </script>
}
