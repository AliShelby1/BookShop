@model IEnumerable<BookShop.Models.Publisher>

@{
    ViewData["Title"] = "Publishers";
}

<div class="container-fluid py-4 px-md-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark">
                <i class="bi bi-building-fill text-primary me-2"></i>Publisher Management
            </h1>
            <p class="text-muted mb-0">Manage publishing houses and press profiles</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>Add New Publisher
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">All Publishers</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary text-uppercase small">
                        <tr>
                            <th scope="col" class="ps-4">Publisher Name</th>
                            <th scope="col">Description</th>
                            <th scope="col">Books Published</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    No publishers found. Click "Add New Publisher" to create one.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var publisher in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3" style="width: 38px; height: 38px;">
                                                <i class="bi bi-building"></i>
                                            </div>
                                            <span class="fw-semibold text-dark">@publisher.Name</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted small">
                                            @(string.IsNullOrWhiteSpace(publisher.Description) 
                                                ? "No description provided." 
                                                : (publisher.Description.Length > 90 ? publisher.Description.Substring(0, 90) + "..." : publisher.Description))
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1">
                                            <i class="bi bi-book me-1"></i>@(publisher.Books?.Count ?? 0) Books
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@publisher.Id" class="btn btn-sm btn-outline-primary" title="Edit Publisher">
                                                <i class="bi bi-pencil-square me-1"></i>Edit
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@publisher.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Delete Publisher"
                                                        onclick="return confirm('Are you sure you want to delete publisher \'@publisher.Name\'?');">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
