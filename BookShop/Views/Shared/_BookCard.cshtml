@model BookShop.Models.Book
@inject BookShop.Services.ILanguageService Lang

<div class="card h-100 book-card position-relative overflow-hidden">
    <!-- Quiet Terracotta Discount Pill -->
    @if (Model.DiscountPercentage.HasValue && Model.DiscountPercentage > 0)
    {
        <span class="position-absolute top-0 @(Lang.IsRtl ? "end-0" : "start-0") m-3 badge badge-terracotta rounded-pill px-2 py-1 shadow-sm" style="z-index: 2; font-size: 0.75rem;">
            -@Model.DiscountPercentage%
        </span>
    }

    <!-- Book Cover Stage -->
    <div class="book-cover-container position-relative text-center d-flex align-items-center justify-content-center" style="height: 270px;">
        <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id" class="d-inline-block">
            @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl" alt="@Model.Title" class="img-fluid book-cover-img book-spine-shadow" style="max-height: 220px; width: auto; object-fit: contain;" />
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center text-muted p-4 border rounded bg-white" style="width: 140px; height: 200px;">
                    <i class="bi bi-book fs-2 mb-2" style="color: var(--c-cafe-light);"></i>
                    <span class="small font-serif">@(Lang.IsRtl ? "طبعة بوك شوب" : "BookShop Edition")</span>
                </div>
            }
        </a>
    </div>

    <!-- Book Body -->
    <div class="card-body d-flex flex-column p-3">
        <!-- Genre & Language Tags -->
        <div class="mb-1 d-flex justify-content-between align-items-center">
            <span class="text-uppercase tracking-wider text-muted fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                @(Model.Category?.GetDisplayName(Lang.IsRtl) ?? (Lang.IsRtl ? "أدب عام" : "Literature"))
            </span>
            <span class="badge bg-light text-muted border py-0 px-1 font-sans" style="font-size: 0.68rem;">
                <i class="bi bi-translate me-1"></i>@Model.GetDisplayLanguage(Lang.IsRtl)
            </span>
        </div>

        <!-- Book Title (Classic Serif) -->
        @{
            var isArTitle = Lang.IsRtl && !string.IsNullOrWhiteSpace(Model.TitleAr);
            var displayTitle = Model.GetDisplayTitle(Lang.IsRtl);
        }
        <h6 class="book-title mb-1 text-truncate-2 @(isArTitle ? "book-title-ar" : "")" style="min-height: 2.7rem; font-size: 1.05rem;" title="@displayTitle">
            <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-dark hover-primary">
                @displayTitle
            </a>
        </h6>

        <!-- Author line -->
        <p class="text-muted small mb-3 text-truncate" style="font-size: 0.85rem;">
            @Lang["Book_By"] <span class="fw-medium text-secondary">@(Model.Author?.Name ?? (Lang.IsRtl ? "مؤلف مجهول" : "Anonymous"))</span>
        </p>

        <!-- Pricing & Stock Footer -->
        <div class="mt-auto pt-2 border-top">
            <div class="d-flex justify-content-between align-items-baseline mb-2">
                <div>
                    @if (Model.DiscountPercentage.HasValue && Model.DiscountPercentage > 0)
                    {
                        <span class="fw-bold font-serif fs-5" style="color: var(--c-espresso);">${@Model.EffectivePrice.ToString("0.00")}</span>
                        <small class="text-muted text-decoration-line-through @(Lang.IsRtl ? "me-1" : "ms-1")">${@Model.Price.ToString("0.00")}</small>
                    }
                    else
                    {
                        <span class="fw-bold font-serif fs-5" style="color: var(--c-espresso);">${@Model.Price.ToString("0.00")}</span>
                    }
                </div>
                <div>
                    @if (Model.StockQuantity > 5)
                    {
                        <small class="text-muted" style="font-size: 0.78rem;">@Lang["Book_Available"]</small>
                    }
                    else if (Model.StockQuantity > 0)
                    {
                        <small class="text-danger" style="font-size: 0.78rem;">@Lang["Book_FewLeft"]</small>
                    }
                    else
                    {
                        <small class="text-secondary" style="font-size: 0.78rem;">@Lang["Book_SoldOut"]</small>
                    }
                </div>
            </div>

            <!-- Minimal Actions -->
            <div class="d-flex gap-2 align-items-center">
                <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id" 
                   class="btn btn-outline-secondary btn-sm flex-grow-1 rounded-pill d-flex align-items-center justify-content-center py-1" style="font-size: 0.82rem;">
                    <span>@Lang["Book_ViewEdition"]</span>
                </a>
                @if (Model.StockQuantity > 0)
                {
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookId" value="@Model.Id" />
                        <input type="hidden" name="quantity" value="1" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="btn btn-primary btn-sm rounded-circle shadow-sm" title="@Lang["Book_AddToBag"]" 
                                style="width: 31px; height: 31px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-bag-plus" style="font-size: 0.85rem;"></i>
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
