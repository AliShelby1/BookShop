@model BookShop.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-primary bg-gradient text-white py-3 text-center rounded-top">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-tag-fill me-2"></i>Create New Category</h4>
                    <small class="text-white-50">Add a new book category to the catalog</small>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Name" class="form-control" placeholder="e.g. Science Fiction" />
                            <label asp-for="Name">Category Name (English)</label>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="NameAr" class="form-control" placeholder="مثال: روايات وقصص" dir="rtl" />
                            <label asp-for="NameAr">Category Name (Arabic / اسم التصنيف بالعربية)</label>
                            <span asp-validation-for="NameAr" class="text-danger small"></span>
                            <div class="form-text">Displayed on the storefront when viewing the site in Arabic.</div>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="DisplayOrder" class="form-control" placeholder="1" />
                            <label asp-for="DisplayOrder">Display Order (1-100)</label>
                            <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                            <div class="form-text">Lower numbers appear first in the navigation menu.</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="IconClass" class="form-label fw-semibold small text-muted text-uppercase">Genre Outlined Icon</label>
                            <select asp-for="IconClass" class="form-select">
                                <option value="bi-book">Book (Default)</option>
                                <option value="bi-rocket-takeoff">Rocket (Science Fiction)</option>
                                <option value="bi-code-slash">Code (Technology)</option>
                                <option value="bi-briefcase">Briefcase (Business)</option>
                                <option value="bi-journal-bookmark">Journal (Fiction)</option>
                                <option value="bi-lightbulb">Lightbulb (Self-Help)</option>
                                <option value="bi-feather">Feather (Poetry)</option>
                                <option value="bi-compass">Compass (Travel & Adventure)</option>
                                <option value="bi-heart">Heart (Romance)</option>
                                <option value="bi-globe">Globe (History)</option>
                            </select>
                            <span asp-validation-for="IconClass" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1 shadow-sm">
                                <i class="bi bi-check-lg me-1"></i>Create Category
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
