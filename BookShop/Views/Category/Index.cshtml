@model IEnumerable<BookShop.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="container-fluid py-4 px-md-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark">
                <i class="bi bi-tag-fill text-primary me-2"></i>Category Management
            </h1>
            <p class="text-muted mb-0">Organize and structure books across the store catalog</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>Create New Category
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">All Categories</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary text-uppercase small">
                        <tr>
                            <th scope="col" class="ps-4">Display Order</th>
                            <th scope="col">Category Name</th>
                            <th scope="col">Books Count</th>
                            <th scope="col">Created Date</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No categories found. Click "Create New Category" to add one.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-light text-dark border px-2 py-1">@category.DisplayOrder</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark">@category.Name</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1">
                                            <i class="bi bi-book me-1"></i>@(category.Books?.Count ?? 0) Books
                                        </span>
                                    </td>
                                    <td class="text-muted small">
                                        @category.CreatedAt.ToString("MMM dd, yyyy")
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary" title="Edit Category">
                                                <i class="bi bi-pencil-square me-1"></i>Edit
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Delete Category"
                                                        onclick="return confirm('Are you sure you want to delete category \'@category.Name\'?');">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
