@model BookShop.Models.ViewModels.StorefrontCuratorVM

@{
    ViewData["Title"] = "Homepage Curator";
}

<div class="container-fluid py-4 px-md-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h3 font-serif fw-bold text-dark mb-1">
                <i class="bi bi-sliders me-2" style="color: var(--c-cafe);"></i>Homepage Curator & Display Control
            </h1>
            <p class="text-muted small mb-0">Control the front-facing bookstore presentation, hero spotlight, featured editions, and genre icons</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill">
                <i class="bi bi-box-arrow-up-right me-1"></i>Preview Live Homepage
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 1. Spotlight Volume of the Month -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 font-serif fw-bold text-dark">
                <i class="bi bi-star me-2" style="color: var(--c-cafe);"></i>Hero Section &middot; Volume of the Month
            </h5>
            <span class="badge badge-cafe">Spotlight Position</span>
        </div>
        <div class="card-body p-4">
            <div class="row g-4 align-items-center">
                <!-- Left: Live Preview -->
                <div class="col-md-5 col-lg-4 text-center">
                    <div class="p-3 rounded-3 border bg-light">
                        <div class="small fw-semibold text-muted text-uppercase mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">Currently Spotlighted</div>
                        @if (Model.CurrentVolumeOfTheMonth != null)
                        {
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.CurrentVolumeOfTheMonth.Id" target="_blank" class="d-inline-block text-decoration-none">
                                <img src="@Model.CurrentVolumeOfTheMonth.CoverImageUrl" alt="@Model.CurrentVolumeOfTheMonth.Title" class="img-fluid book-spine-shadow rounded-2 mb-2" style="max-height: 220px; object-fit: contain;" />
                                <h6 class="font-serif fw-bold text-dark mb-1">@Model.CurrentVolumeOfTheMonth.Title</h6>
                                <p class="text-muted small mb-1">by @(Model.CurrentVolumeOfTheMonth.Author?.Name ?? "Unknown")</p>
                                <span class="badge badge-earth">Clickable on Hero Banner &rarr;</span>
                            </a>
                        }
                        else
                        {
                            <div class="py-4 text-muted">
                                <i class="bi bi-book fs-1 d-block mb-2"></i>
                                <span>No volume currently spotlighted. Please choose one below.</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Right: Selection Control -->
                <div class="col-md-7 col-lg-8">
                    <h6 class="fw-bold text-dark mb-2">Change the Spotlighted Book</h6>
                    <p class="text-muted small mb-3">
                        The selected title will appear prominently on the Home Page hero banner with the 3D floating animation. When readers click the book cover or title on the home page, it will take them directly to that book's details page.
                    </p>

                    <form asp-action="SetVolumeOfTheMonth" method="post" class="row g-2 align-items-center">
                        <div class="col-sm-8">
                            <select name="bookId" class="form-select form-select-lg">
                                @foreach (var book in Model.AllActiveBooks)
                                {
                                    <option value="@book.Id" selected="@(book.IsVolumeOfTheMonth ? "selected" : null)">
                                        @book.Title (by @(book.Author?.Name ?? "Unknown")) - @book.Price.ToString("C")
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-4">
                            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill">
                                <i class="bi bi-check2 me-1"></i>Set Volume
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Featured Editions Curation -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 font-serif fw-bold text-dark">
                <i class="bi bi-bookmark-check me-2" style="color: var(--c-cafe);"></i>Featured Editions Showcase
            </h5>
            <span class="badge badge-earth">@Model.FeaturedBookIds.Count Books Featured</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary text-uppercase small">
                        <tr>
                            <th scope="col" class="ps-4">Cover</th>
                            <th scope="col">Title</th>
                            <th scope="col">Author</th>
                            <th scope="col">Category</th>
                            <th scope="col">Price</th>
                            <th scope="col">Home Status</th>
                            <th scope="col" class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.AllActiveBooks)
                        {
                            <tr>
                                <td class="ps-4" style="width: 60px;">
                                    <img src="@book.CoverImageUrl" alt="@book.Title" class="rounded shadow-sm" style="width: 38px; height: 54px; object-fit: cover;" />
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@book.Title</span>
                                    @if (book.IsVolumeOfTheMonth)
                                    {
                                        <span class="badge badge-cafe ms-1 small">Hero Spotlight</span>
                                    }
                                </td>
                                <td class="text-muted small">@(book.Author?.Name ?? "—")</td>
                                <td><span class="badge badge-earth">@(book.Category?.Name ?? "—")</span></td>
                                <td class="fw-semibold">@book.EffectivePrice.ToString("C")</td>
                                <td>
                                    @if (book.IsFeatured)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Featured on Home
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Standard Catalog</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-action="ToggleFeatured" method="post" class="d-inline">
                                        <input type="hidden" name="bookId" value="@book.Id" />
                                        <button type="submit" class="btn btn-sm @(book.IsFeatured ? "btn-outline-danger" : "btn-outline-primary") rounded-pill px-3">
                                            @(book.IsFeatured ? "Remove from Featured" : "Feature on Home")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 3. Category Outlined Icons & Classification -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 font-serif fw-bold text-dark">
                <i class="bi bi-tag me-2" style="color: var(--c-cafe);"></i>Literary Genre Icons
            </h5>
            <small class="text-muted">Customize the outlined icon displayed on the Home Page genre cards for each category</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary text-uppercase small">
                        <tr>
                            <th scope="col" class="ps-4">Order</th>
                            <th scope="col">Genre Name</th>
                            <th scope="col">Current Icon</th>
                            <th scope="col">Icon Class</th>
                            <th scope="col" class="text-end pe-4">Update Icon</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model.Categories)
                        {
                            var icon = string.IsNullOrWhiteSpace(cat.IconClass) ? "bi-book" : cat.IconClass;
                            <tr>
                                <td class="ps-4 fw-bold">@cat.DisplayOrder</td>
                                <td class="fw-semibold text-dark">@cat.Name</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="bi @icon fs-4 me-2" style="color: var(--c-cafe);"></i>
                                        <span class="small text-muted font-monospace">@icon</span>
                                    </div>
                                </td>
                                <td colspan="2" class="pe-4 text-end">
                                    <form asp-action="UpdateCategoryIcon" method="post" class="d-flex justify-content-end gap-2 align-items-center">
                                        <input type="hidden" name="categoryId" value="@cat.Id" />
                                        <select name="iconClass" class="form-select form-select-sm w-auto">
                                            <option value="bi-book" selected="@(icon == "bi-book" ? "selected" : null)">Book (bi-book)</option>
                                            <option value="bi-rocket-takeoff" selected="@(icon == "bi-rocket-takeoff" ? "selected" : null)">Rocket / Sci-Fi (bi-rocket-takeoff)</option>
                                            <option value="bi-code-slash" selected="@(icon == "bi-code-slash" ? "selected" : null)">Code / Tech (bi-code-slash)</option>
                                            <option value="bi-briefcase" selected="@(icon == "bi-briefcase" ? "selected" : null)">Briefcase / Business (bi-briefcase)</option>
                                            <option value="bi-journal-bookmark" selected="@(icon == "bi-journal-bookmark" ? "selected" : null)">Journal / Fiction (bi-journal-bookmark)</option>
                                            <option value="bi-lightbulb" selected="@(icon == "bi-lightbulb" ? "selected" : null)">Lightbulb / Self-Help (bi-lightbulb)</option>
                                            <option value="bi-feather" selected="@(icon == "bi-feather" ? "selected" : null)">Feather / Poetry (bi-feather)</option>
                                            <option value="bi-compass" selected="@(icon == "bi-compass" ? "selected" : null)">Compass / Travel (bi-compass)</option>
                                            <option value="bi-heart" selected="@(icon == "bi-heart" ? "selected" : null)">Heart / Romance (bi-heart)</option>
                                            <option value="bi-globe" selected="@(icon == "bi-globe" ? "selected" : null)">Globe / History (bi-globe)</option>
                                        </select>
                                        <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                            Save Icon
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 4. Store & Cart Policies Control (Continuous Admin Control) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" id="storePoliciesCard">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 font-serif fw-bold text-dark">
                <i class="bi bi-truck me-2" style="color: var(--c-cafe);"></i>Store & Cart Policies &middot; Continuous Control
            </h5>
            <span class="badge badge-earth">Shopping Bag Settings</span>
        </div>
        <div class="card-body p-4">
            <p class="text-muted small mb-4">
                Manage global e-commerce rules, shipping thresholds, order quantities, and promotional announcements displayed across reading bags.
            </p>

            <form asp-action="UpdateStoreSettings" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.StoreSettings.Id" />

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-muted">Free Shipping Threshold ($)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">$</span>
                            <input type="number" step="0.01" min="0" class="form-control" name="FreeShippingThreshold" value="@Model.StoreSettings.FreeShippingThreshold" required />
                        </div>
                        <div class="form-text small">Orders equal or exceeding this amount unlock complimentary delivery.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-muted">Flat Shipping Rate ($)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">$</span>
                            <input type="number" step="0.01" min="0" class="form-control" name="FlatShippingRate" value="@Model.StoreSettings.FlatShippingRate" required />
                        </div>
                        <div class="form-text small">Standard rate charged when subtotal is below the free shipping threshold.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-muted">Max Quantity Per Book</label>
                        <input type="number" min="1" max="100" class="form-control" name="MaxQuantityPerBook" value="@Model.StoreSettings.MaxQuantityPerBook" required />
                        <div class="form-text small">Maximum copies a customer can add to their bag for a single title.</div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Default Storefront Language</label>
                        <select name="DefaultLanguage" class="form-select">
                            <option value="en" selected="@(Model.StoreSettings.DefaultLanguage == "en" ? "selected" : null)">English (Default)</option>
                            <option value="ar" selected="@(Model.StoreSettings.DefaultLanguage == "ar" ? "selected" : null)">العربية (Arabic)</option>
                        </select>
                        <div class="form-text small">Initial language loaded for new visitors before manual selection.</div>
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" role="switch" id="switchLang" name="EnableLanguageSwitcher" value="true" @(Model.StoreSettings.EnableLanguageSwitcher ? "checked" : "") />
                            <input type="hidden" name="EnableLanguageSwitcher" value="false" />
                            <label class="form-check-label fw-semibold small text-dark" for="switchLang">
                                Display Language Switcher in Header
                            </label>
                            <div class="form-text small">Allows customers to toggle between English and Arabic.</div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Cart Promotional Announcement Banner (English)</label>
                    <input type="text" maxlength="250" class="form-control" name="CartAnnouncementBanner" value="@Model.StoreSettings.CartAnnouncementBanner" />
                    <div class="form-text small">Displayed inside the customer's reading bag when viewing in English.</div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold text-muted">Cart Promotional Announcement Banner (العربية)</label>
                    <input type="text" maxlength="250" class="form-control text-end" dir="rtl" name="CartAnnouncementBannerAr" value="@Model.StoreSettings.CartAnnouncementBannerAr" />
                    <div class="form-text small">يظهر داخل حقيبة القراءة للمستخدمين عند تصفح المتجر باللغة العربية.</div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i>Save Store Policies & Language Settings
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
