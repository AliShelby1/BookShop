@model IEnumerable<BookShop.Models.Book>

@{
    ViewData["Title"] = "Book Management";
}

<div class="container-fluid py-4 px-md-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark">
                <i class="bi bi-book-half text-primary me-2"></i>Book Management
            </h1>
            <p class="text-muted mb-0">Manage bookstore inventory, pricing, descriptions, and cover assets</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="Upsert" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>Add New Book
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control bg-light border-start-0" placeholder="Search by title or ISBN..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="categoryId" class="form-select bg-light searchable-select">
                        <option value="">-- All Categories --</option>
                        @foreach (var cat in (IEnumerable<SelectListItem>)ViewBag.Categories)
                        {
                            <option value="@cat.Value" selected="@(cat.Selected ? "selected" : null)">@cat.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-filter me-1"></i>Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-semibold">Inventory (@Model.Count() books)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary text-uppercase small">
                        <tr>
                            <th scope="col" class="ps-4">Cover</th>
                            <th scope="col">Title & ISBN</th>
                            <th scope="col">Author</th>
                            <th scope="col">Category</th>
                            <th scope="col">Price</th>
                            <th scope="col">Stock</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No books match the search criteria. Click "Add New Book" or reset filters.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var book in Model)
                            {
                                <tr>
                                    <td class="ps-4" style="width: 70px;">
                                        @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                                        {
                                            <img src="@book.CoverImageUrl" alt="@book.Title" class="rounded shadow-sm" style="width: 48px; height: 68px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light text-muted rounded d-flex align-items-center justify-content-center border" style="width: 48px; height: 68px;">
                                                <i class="bi bi-book"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">
                                            <a asp-action="Details" asp-route-id="@book.Id" class="text-dark text-decoration-none hover-primary">
                                                @book.Title
                                            </a>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(book.TitleAr))
                                        {
                                            <div class="small font-serif text-muted" dir="rtl">
                                                @book.TitleAr
                                            </div>
                                        }
                                        <div class="text-muted small">
                                            <code>@book.ISBN</code> &middot; 
                                            <span class="badge bg-light text-dark border px-1">
                                                <i class="bi bi-translate me-1"></i>@book.Language
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-secondary small">@(book.Author?.Name ?? "—")</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1">
                                            @(book.Category?.Name ?? "—")
                                        </span>
                                    </td>
                                    <td>
                                        @if (book.DiscountPercentage.HasValue && book.DiscountPercentage > 0)
                                        {
                                            <div>
                                                <span class="fw-bold text-success">@book.EffectivePrice.ToPrice()</span>
                                                <small class="badge bg-danger ms-1">-@book.DiscountPercentage%</small>
                                            </div>
                                            <small class="text-muted text-decoration-line-through">@book.Price.ToPrice()</small>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-dark">@book.Price.ToPrice()</span>
                                        }
                                    </td>
                                    <td>
                                        @if (book.StockQuantity > 10)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">
                                                @book.StockQuantity in stock
                                            </span>
                                        }
                                        else if (book.StockQuantity > 0)
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning px-2 py-1">
                                                @book.StockQuantity low stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1">
                                                Out of stock
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (book.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                        @if (book.IsVolumeOfTheMonth)
                                        {
                                            <div class="mt-1"><span class="badge badge-cafe small">Spotlight</span></div>
                                        }
                                        @if (book.IsFeatured)
                                        {
                                            <div class="mt-1"><span class="badge badge-earth small">Featured</span></div>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Upsert" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary" title="Edit Book">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <!-- Toggle Status -->
                                            <form asp-action="ToggleStatus" asp-route-id="@book.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm @(book.IsActive ? "btn-outline-warning" : "btn-outline-success") ms-1"
                                                        title="@(book.IsActive ? "Deactivate Book" : "Activate Book")">
                                                    <i class="bi @(book.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                                </button>
                                            </form>
                                            <!-- Delete -->
                                            <form asp-action="Delete" asp-route-id="@book.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Delete Book"
                                                        onclick="return confirm('Are you sure you want to permanently delete \'@book.Title\'?');">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
