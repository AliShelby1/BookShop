@model BookShop.Models.ViewModels.BookVM

@{
    var isEdit = Model.Book.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Book" : "Create Book";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-primary bg-gradient text-white py-3 text-center rounded-top">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi @(isEdit ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEdit ? "Edit Book" : "Add New Book")
                    </h4>
                    <small class="text-white-50">@(isEdit ? "Update book information and inventory" : "Add a new book title to the catalog")</small>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Book.Id" />
                        <input type="hidden" asp-for="Book.CoverImageUrl" />
                        <input type="hidden" asp-for="Book.CreatedAt" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-4">
                            <!-- Left Column: Details -->
                            <div class="col-md-8">
                                <h5 class="text-secondary fw-semibold mb-3 border-bottom pb-2">Book Information</h5>

                                <div class="form-floating mb-3">
                                    <input asp-for="Book.Title" class="form-control" placeholder="Book Title" />
                                    <label asp-for="Book.Title">Title</label>
                                    <span asp-validation-for="Book.Title" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Book.Description" class="form-label fw-semibold">Description</label>
                                    <textarea asp-for="Book.Description" class="form-control" rows="5" placeholder="Full synopsis, overview, table of contents..."></textarea>
                                    <span asp-validation-for="Book.Description" class="text-danger small"></span>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-sm-6">
                                        <div class="form-floating">
                                            <input asp-for="Book.ISBN" class="form-control" placeholder="978-0132350884" />
                                            <label asp-for="Book.ISBN">ISBN</label>
                                            <span asp-validation-for="Book.ISBN" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="form-floating">
                                            <input asp-for="Book.StockQuantity" class="form-control" placeholder="50" />
                                            <label asp-for="Book.StockQuantity">Stock Quantity</label>
                                            <span asp-validation-for="Book.StockQuantity" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-sm-6">
                                        <div class="form-floating">
                                            <input asp-for="Book.Price" class="form-control" placeholder="29.99" />
                                            <label asp-for="Book.Price">Price ($)</label>
                                            <span asp-validation-for="Book.Price" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="form-floating">
                                            <input asp-for="Book.DiscountPercentage" class="form-control" placeholder="0" />
                                            <label asp-for="Book.DiscountPercentage">Discount % (Optional)</label>
                                            <span asp-validation-for="Book.DiscountPercentage" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="p-3 bg-light rounded-3 border mb-3">
                                    <h6 class="text-uppercase small fw-bold text-muted mb-2" style="font-size: 0.72rem; letter-spacing: 0.05em;">Storefront Positioning</h6>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" asp-for="Book.IsActive" id="isActiveSwitch">
                                        <label class="form-check-label fw-semibold small" for="isActiveSwitch">Active in Store Catalog</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" asp-for="Book.IsFeatured" id="isFeaturedSwitch">
                                        <label class="form-check-label fw-semibold small" for="isFeaturedSwitch">Featured Edition (Featured on Home)</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" asp-for="Book.IsVolumeOfTheMonth" id="isVolumeSwitch">
                                        <label class="form-check-label fw-semibold small" for="isVolumeSwitch">Volume of the Month (Hero Spotlight)</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column: Relationships & Cover Image -->
                            <div class="col-md-4">
                                <h5 class="text-secondary fw-semibold mb-3 border-bottom pb-2">Classification & Media</h5>

                                <div class="mb-3">
                                    <label asp-for="Book.CategoryId" class="form-label fw-semibold">Category</label>
                                    <select asp-for="Book.CategoryId" asp-items="@Model.CategoryList" class="form-select">
                                        <option disabled selected>-- Select Category --</option>
                                    </select>
                                    <span asp-validation-for="Book.CategoryId" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Book.AuthorId" class="form-label fw-semibold">Author</label>
                                    <select asp-for="Book.AuthorId" asp-items="@Model.AuthorList" class="form-select">
                                        <option disabled selected>-- Select Author --</option>
                                    </select>
                                    <span asp-validation-for="Book.AuthorId" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Book.PublisherId" class="form-label fw-semibold">Publisher (Optional)</label>
                                    <select asp-for="Book.PublisherId" asp-items="@Model.PublisherList" class="form-select">
                                        <option value="">-- None / Unknown --</option>
                                    </select>
                                    <span asp-validation-for="Book.PublisherId" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Cover Image File</label>
                                    <input type="file" name="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                                    <div class="form-text small">Upload .jpg, .png, or .webp image</div>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.Book.CoverImageUrl))
                                {
                                    <div class="mt-3 text-center border p-2 rounded bg-light">
                                        <div class="small fw-semibold text-muted mb-2">Current Cover:</div>
                                        <img src="@Model.Book.CoverImageUrl" alt="@Model.Book.Title" class="img-fluid rounded shadow-sm" style="max-height: 180px; object-fit: contain;" />
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg px-4 shadow-sm">
                                <i class="bi bi-check-lg me-1"></i>@(isEdit ? "Update Book" : "Create Book")
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
