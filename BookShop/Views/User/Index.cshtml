@model IEnumerable<BookShop.Models.ViewModels.UserViewModel>
@using BookShop.Utility

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid py-4 px-md-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark">
                <i class="bi bi-people-fill text-primary me-2"></i>User Management
            </h1>
            <p class="text-muted mb-0">View, manage roles, and control access for all registered users</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i>Create New User
            </a>
        </div>
    </div>

    <!-- Notification Alerts -->
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Badges -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-primary bg-opacity-10 text-primary p-3 rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small fw-semibold text-uppercase">Total Users</div>
                        <div class="fs-4 fw-bold">@Model.Count()</div>
                    </div>
                    <i class="bi bi-people fs-1 text-primary opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-danger bg-opacity-10 text-danger p-3 rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small fw-semibold text-uppercase">Admins</div>
                        <div class="fs-4 fw-bold">@Model.Count(u => u.Role == SD.Role_Admin)</div>
                    </div>
                    <i class="bi bi-shield-lock fs-1 text-danger opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-warning bg-opacity-10 text-dark p-3 rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small fw-semibold text-uppercase">Employees</div>
                        <div class="fs-4 fw-bold">@Model.Count(u => u.Role == SD.Role_Employee)</div>
                    </div>
                    <i class="bi bi-person-badge fs-1 text-warning opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-secondary bg-opacity-10 text-secondary p-3 rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small fw-semibold text-uppercase">Customers</div>
                        <div class="fs-4 fw-bold">@Model.Count(u => u.Role == SD.Role_Customer)</div>
                    </div>
                    <i class="bi bi-person fs-1 text-secondary opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center g-2">
                <div class="col-md-4">
                    <h5 class="mb-0 fw-semibold">User Directory</h5>
                </div>
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="userSearchInput" class="form-control bg-light border-start-0" placeholder="Search by name, email, phone, or role..." />
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="userTable">
                    <thead class="table-light text-secondary text-uppercase small">
                        <tr>
                            <th scope="col" class="ps-4">User</th>
                            <th scope="col">Phone</th>
                            <th scope="col">Location</th>
                            <th scope="col">Role</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr class="user-row">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person-fill fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold user-name">@(string.IsNullOrWhiteSpace(user.Name) ? "—" : user.Name)</div>
                                            <div class="text-muted small user-email">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="user-phone">
                                    @(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "—" : user.PhoneNumber)
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(user.City) || !string.IsNullOrWhiteSpace(user.State))
                                    {
                                        <span>@user.City@(string.IsNullOrWhiteSpace(user.City) || string.IsNullOrWhiteSpace(user.State) ? "" : ", ")@user.State</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (user.Role == SD.Role_Admin)
                                    {
                                        <span class="badge bg-danger user-role px-2 py-1"><i class="bi bi-shield-lock-fill me-1"></i>Admin</span>
                                    }
                                    else if (user.Role == SD.Role_Employee)
                                    {
                                        <span class="badge bg-warning text-dark user-role px-2 py-1"><i class="bi bi-person-badge-fill me-1"></i>Employee</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary user-role px-2 py-1"><i class="bi bi-person me-1"></i>Customer</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsLocked)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1">
                                            <i class="bi bi-lock-fill me-1"></i>Locked
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Active
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group" role="group">
                                        <!-- Edit Role -->
                                        <a asp-action="RoleManagement" asp-route-userId="@user.Id" class="btn btn-sm btn-outline-primary" title="Manage Role">
                                            <i class="bi bi-pencil-square me-1"></i>Role
                                        </a>

                                        <!-- Lock / Unlock Form -->
                                        <form asp-action="LockUnlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                            @if (user.IsLocked)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success ms-1" title="Unlock Account" onclick="return confirm('Are you sure you want to unlock account for @user.Email?');">
                                                    <i class="bi bi-unlock-fill me-1"></i>Unlock
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-warning ms-1" title="Lock Account" onclick="return confirm('Are you sure you want to lock account for @user.Email?');">
                                                    <i class="bi bi-lock-fill me-1"></i>Lock
                                                </button>
                                            }
                                        </form>

                                        <!-- Delete Form -->
                                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Delete User" onclick="return confirm('Are you sure you want to permanently delete user @user.Email? This action cannot be undone.');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Real-time table search filter
        document.getElementById('userSearchInput').addEventListener('input', function () {
            const filter = this.value.toLowerCase().trim();
            const rows = document.querySelectorAll('#userTable .user-row');

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}
