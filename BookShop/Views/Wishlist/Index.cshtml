@model BookShop.Models.ViewModels.WishlistVM
@inject BookShop.Services.ILanguageService Lang

@{
    ViewData["Title"] = Lang["Wishlist_Title"];
}

<div class="container py-4 py-md-5">
    <!-- Header Stage -->
    <div class="border-bottom pb-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3">
            <div>
                <span class="text-uppercase tracking-wider text-muted fw-semibold small">
                    <i class="bi bi-bookmark-heart me-1" style="color: var(--c-terracotta);"></i>@Lang["Hero_Badge"]
                </span>
                <h1 class="font-serif fw-bold display-6 mb-1 text-dark">@Lang["Wishlist_Title"]</h1>
                <p class="text-secondary mb-0">@Lang["Wishlist_Subtitle"]</p>
            </div>
            <div>
                <span class="badge rounded-pill bg-light text-secondary border px-3 py-2 fs-6 font-sans">
                    <i class="bi bi-heart-fill text-danger @(Lang.IsRtl ? "ms-1" : "me-1")"></i>
                    @Model.TotalItems @(Model.TotalItems == 1 ? Lang["Wishlist_VolumeCount"] : Lang["Wishlist_VolumesCount"])
                </span>
            </div>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill @(Lang.IsRtl ? "ms-2" : "me-2")"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill @(Lang.IsRtl ? "ms-2" : "me-2")"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.IsEmpty)
    {
        <!-- Poetic Empty State -->
        <div class="text-center py-5 my-4 bg-light rounded-4 border border-secondary-subtle px-3">
            <div class="mb-4">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white shadow-sm" style="width: 80px; height: 80px;">
                    <i class="bi bi-heart text-muted display-6"></i>
                </span>
            </div>
            <h3 class="font-serif fw-bold text-dark mb-2">@Lang["Wishlist_EmptyTitle"]</h3>
            <p class="text-secondary mx-auto mb-4" style="max-width: 520px; font-size: 1.05rem; line-height: 1.7;">
                @Lang["Wishlist_EmptyDesc"]
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Shop" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">
                    <i class="bi bi-compass @(Lang.IsRtl ? "ms-2" : "me-2")"></i>@Lang["Wishlist_ExploreBtn"]
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Saved Volumes Grid -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
            @foreach (var item in Model.Items)
            {
                <div class="col">
                    <div class="card h-100 book-card position-relative overflow-hidden shadow-sm border">
                        <!-- Cover Container -->
                        <div class="book-cover-container position-relative text-center d-flex align-items-center justify-content-center bg-light p-3" style="height: 240px;">
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@item.BookId">
                                <img src="@item.DisplayCoverImageUrl" 
                                     alt="" 
                                     class="img-fluid book-cover-img book-spine-shadow rounded-2" 
                                     style="max-height: 200px; width: auto; object-fit: contain;" 
                                     onerror="if(this.src.indexOf('default-book-cover.svg')===-1){this.src='/images/default-book-cover.svg';}" />
                            </a>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body d-flex flex-column p-3">
                            <!-- Category & In-Stock Status -->
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-uppercase tracking-wider text-muted fw-semibold" style="font-size: 0.72rem;">
                                    @(Lang.IsRtl ? (item.CategoryNameAr ?? item.CategoryName) : (item.CategoryName ?? "Literature"))
                                </span>
                                @if (item.IsInStock)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle py-1 px-2" style="font-size: 0.7rem;">
                                        @Lang["Wishlist_InStock"]
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle py-1 px-2" style="font-size: 0.7rem;">
                                        @Lang["Wishlist_OutOfStock"]
                                    </span>
                                }
                            </div>

                            <!-- Title -->
                            <h6 class="book-title font-serif mb-1 text-truncate-2" style="min-height: 2.6rem;">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@item.BookId" class="text-decoration-none text-dark hover-primary">
                                    @item.GetDisplayTitle(Lang.IsRtl)
                                </a>
                            </h6>

                            <!-- Author -->
                            <p class="text-muted small mb-2 text-truncate">
                                @Lang["Book_By"] <span class="fw-medium text-secondary">@(item.AuthorName ?? (Lang.IsRtl ? "مؤلف مجهول" : "Anonymous"))</span>
                            </p>

                            <!-- Price -->
                            <div class="mt-auto pt-2 border-top">
                                <div class="d-flex justify-content-between align-items-baseline mb-3">
                                    <div>
                                        <span class="fw-bold font-serif fs-5" style="color: var(--c-espresso);">@item.UnitPrice.ToPrice()</span>
                                        @if (item.DiscountPercentage.HasValue && item.DiscountPercentage > 0)
                                        {
                                            <small class="text-muted text-decoration-line-through @(Lang.IsRtl ? "me-1" : "ms-1")">@item.OriginalPrice.ToPrice()</small>
                                        }
                                    </div>
                                    <small class="text-muted" style="font-size: 0.75rem;">
                                        @Lang["Wishlist_DateAdded"] @item.AddedAt.ToString("d MMM")
                                    </small>
                                </div>

                                <!-- Action Buttons: Move to Bag & Remove -->
                                <div class="d-flex gap-2">
                                    @if (item.IsInStock)
                                    {
                                        <form asp-controller="Wishlist" asp-action="MoveToBag" method="post" class="flex-grow-1 m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookId" value="@item.BookId" />
                                            <input type="hidden" name="returnUrl" value="/Wishlist" />
                                            <button type="submit" class="btn btn-primary btn-sm rounded-pill w-100 py-1 d-flex align-items-center justify-content-center gap-1 shadow-sm">
                                                <i class="bi bi-bag-plus"></i>
                                                <span>@Lang["Wishlist_MoveToBag"]</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm rounded-pill flex-grow-1 py-1 disabled" disabled>
                                            <span>@Lang["Wishlist_OutOfStock"]</span>
                                        </button>
                                    }

                                    <form asp-controller="Wishlist" asp-action="Remove" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookId" value="@item.BookId" />
                                        <input type="hidden" name="returnUrl" value="/Wishlist" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle d-flex align-items-center justify-content-center shadow-none" 
                                                title="@Lang["Wishlist_Remove"]" style="width: 32px; height: 32px; padding: 0;">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Footer Actions -->
        <div class="d-flex justify-content-between align-items-center border-top pt-4">
            <a asp-controller="Home" asp-action="Shop" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left @(Lang.IsRtl ? "bi-arrow-right" : "") @(Lang.IsRtl ? "ms-2" : "me-2")"></i>
                @Lang["Cart_ContinueShopping"]
            </a>
            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4">
                <i class="bi bi-bag @(Lang.IsRtl ? "ms-2" : "me-2")"></i>
                @Lang["Nav_ReadingBag"]
            </a>
        </div>
    }
</div>
