@model BookShop.Models.Author

@{
    ViewData["Title"] = "Add Author";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-primary bg-gradient text-white py-3 text-center rounded-top">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Add New Author</h4>
                    <small class="text-white-50">Add a book author or creator profile</small>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Name" class="form-control" placeholder="e.g. Robert C. Martin" />
                            <label asp-for="Name">Author Full Name</label>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Biography" class="form-label fw-semibold">Author Biography / Notes</label>
                            <textarea asp-for="Biography" class="form-control" rows="5" placeholder="Brief background, achievements, notable publications..."></textarea>
                            <span asp-validation-for="Biography" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1 shadow-sm">
                                <i class="bi bi-check-lg me-1"></i>Save Author
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
