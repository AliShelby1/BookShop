@page
@model RegisterModel
@using BookShop.Utility
@{
    ViewData["Title"] = "Register";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-primary bg-gradient text-white py-3 text-center rounded-top">
                    @if (User.IsInRole(SD.Role_Admin))
                    {
                        <h2 class="h4 mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Register - Admin Portal</h2>
                        <small class="text-white-50">Create an employee, admin, or customer account</small>
                    }
                    else
                    {
                        <h2 class="h4 mb-0 fw-bold">Create Your BookShop Account</h2>
                        <small class="text-white-50">Join our community of book lovers</small>
                    }
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (TempData["success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-4">
                            <!-- Account Details -->
                            <div class="col-md-6 border-end-md">
                                <h5 class="text-secondary fw-semibold mb-3 border-bottom pb-2">Account Details</h5>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Name" class="form-control" placeholder="John Doe" aria-required="true" />
                                    <label asp-for="Input.Name">Full Name</label>
                                    <span asp-validation-for="Input.Name" class="text-danger small"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" aria-required="true" />
                                    <label asp-for="Input.Email">Email Address</label>
                                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                                </div>

                                <div class="form-floating mb-3 position-relative">
                                    <input asp-for="Input.Password" class="form-control pe-5" id="registerPassword" autocomplete="new-password" placeholder="password" aria-required="true" />
                                    <label asp-for="Input.Password">Password</label>
                                    <button type="button" class="password-toggle" data-target="registerPassword" tabindex="-1" title="Show/Hide password (click to toggle or press & hold to peek)" aria-label="Toggle password visibility">
                                        <i class="bi bi-eye fs-5"></i>
                                    </button>
                                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                                </div>

                                <div class="form-floating mb-3 position-relative">
                                    <input asp-for="Input.ConfirmPassword" class="form-control pe-5" id="registerConfirmPassword" autocomplete="new-password" placeholder="password" aria-required="true" />
                                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                                    <button type="button" class="password-toggle" data-target="registerConfirmPassword" tabindex="-1" title="Show/Hide password (click to toggle or press & hold to peek)" aria-label="Toggle password visibility">
                                        <i class="bi bi-eye fs-5"></i>
                                    </button>
                                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                                </div>

                                @if (User.IsInRole(SD.Role_Admin))
                                {
                                    <div class="form-floating mb-3">
                                        <select asp-for="Input.Role" asp-items="@Model.Input.RoleList" class="form-select">
                                            <option disabled selected>-- Select Role --</option>
                                        </select>
                                        <label asp-for="Input.Role">Assigned Role</label>
                                    </div>
                                }
                            </div>

                            <!-- Shipping & Contact Details -->
                            <div class="col-md-6">
                                <h5 class="text-secondary fw-semibold mb-3 border-bottom pb-2">Shipping & Contact Info</h5>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="1234567890" />
                                    <label asp-for="Input.PhoneNumber">Phone Number</label>
                                    <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.StreetAddress" class="form-control" placeholder="123 Main St" />
                                    <label asp-for="Input.StreetAddress">Street Address</label>
                                    <span asp-validation-for="Input.StreetAddress" class="text-danger small"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.City" class="form-control" placeholder="Chicago" />
                                    <label asp-for="Input.City">City</label>
                                    <span asp-validation-for="Input.City" class="text-danger small"></span>
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-sm-6">
                                        <div class="form-floating">
                                            <input asp-for="Input.State" class="form-control" placeholder="IL" />
                                            <label asp-for="Input.State">State</label>
                                            <span asp-validation-for="Input.State" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="form-floating">
                                            <input asp-for="Input.PostalCode" class="form-control" placeholder="60007" />
                                            <label asp-for="Input.PostalCode">Postal Code</label>
                                            <span asp-validation-for="Input.PostalCode" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-2 text-center">
                            <button id="registerSubmit" type="submit" class="btn btn-primary btn-lg px-5 shadow-sm">
                                Register Account
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <span class="text-muted">Already have an account?</span>
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary text-decoration-none fw-semibold ms-1">Log in here</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
